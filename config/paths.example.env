# Copy to config/paths.env and edit locally.
# Do not commit config/paths.env.

export SEN_ROOT="/path/to/SEN_project"

export SEN_RAW_READS="$SEN_ROOT/fastq"
export SEN_TRIMMED_READS="$SEN_ROOT/trimmed_fastq"
export SEN_RESULTS="$SEN_ROOT/results"
export SEN_REFERENCE_DIR="$SEN_ROOT/reference"

export SEN_KRAKEN_CLEAN_DIR="$SEN_ROOT/Kraken_cleanup/clean_trimmed_fastq"
export SEN_SNIPPY_OUT="$SEN_ROOT/Snippy_output"
export SEN_GUBBINS_OUT="$SEN_ROOT/gubbin"
export SEN_IQTREE_OUT="$SEN_ROOT/iqtree_final"

export SEN_SHOVILL_OUT="$SEN_ROOT/shovill_assemblies"
export SEN_FINAL_CONTIGS_DIR="$SEN_ROOT/Final_Contigs_Only"
export SEN_PROKKA_OUT="$SEN_ROOT/prokka_annotations"
export SEN_PANAROO_OUT="$SEN_ROOT/Panaroo_Run/results"

export SEN_METADATA_FILE="$SEN_ROOT/metadata/SEN_Genomes.csv"
export SEN_CLADE_METADATA="$SEN_ROOT/metadata/final_clade_metadata.tsv"

# External database paths are intentionally user-configured.
export SEN_KRAKEN_DB="/path/to/kraken_db"
