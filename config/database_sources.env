export SEN_KRAKEN_DB_DATE="20260626"
export SEN_KRAKEN_DB_ARCHIVE="k2_standard_20260626.tar.gz"
export SEN_KRAKEN_DB_URL="https://genome-idx.s3.amazonaws.com/kraken/k2_standard_20260626.tar.gz"
export SEN_KRAKEN_DB_MD5_URL="https://genome-idx.s3.amazonaws.com/kraken/standard_20260626/standard.md5"

# AMRFinderPlus database pinned from successful end-to-end smoke run.
